---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Книга «Если ты — технический писатель» — Екатерина Ушакова"
  description="Книга о профессии технического писателя от практика с опытом в Ozon и Яндексе. Для тех, кто входит в профессию или хочет вырасти. Тираж распродан — можно оставить почту, чтобы узнать о допечатке."
  image="/img/book-cover.webp"
>
  <link rel="stylesheet" href="/css/services-page.css" />

  <section class="book-hero">
    <div class="book-hero__inner">
      <div class="book-hero__cover">
        <img
          src="/img/book-cover.webp"
          alt="Обложка книги «Если ты — технический писатель, то начни с этой книги»"
          loading="eager"
        />
        <p class="book-hero__specs">123 с. · Мягкий переплёт</p>
      </div>
      <div class="book-hero__text">
        <h1>Если ты — технический писатель,<br>то начни с этой книги</h1>
        <p class="book-hero__desc">
          Практическое руководство по профессии технического писателя в России. От первых шагов без опыта до документации, которой пользуются.
        </p>
        <p class="book-hero__tagline">Хотите создавать документацию, которой пользуются? Начните с этой книги.</p>
        <div class="book-hero__meta">
          <span class="book-hero__author">Екатерина Ушакова</span>
          <span class="book-hero__format">Бумажная книга · тираж распродан</span>
        </div>
        <a href="#sold-out" class="cta-primary book-cta">
          Сообщить почту, когда допечатают
        </a>
      </div>
    </div>
  </section>

  <div class="book-content">

    <div class="book-two-col">
      <section class="book-section book-section--panel">
        <h2>Для кого эта книга</h2>
        <div class="book-list">
          <div class="book-list__item">
            <strong>Начинающим техписам</strong>
            <p>Только получили первый оффер или ещё выбираете профессию — книга даёт ориентир на старте.</p>
          </div>
          <div class="book-list__item">
            <strong>Техписам с опытом</strong>
            <p>Уже работаете, но хочется системы и взгляда со стороны.</p>
          </div>
          <div class="book-list__item">
            <strong>Аналитикам и продакт-менеджерам</strong>
            <p>Разобраться, как устроена работа с документацией, и говорить с техписами на одном языке.</p>
          </div>
          <div class="book-list__item">
            <strong>Разработчикам</strong>
            <p>Пишете или читаете документацию, но не понимаете её логику — книга объяснит принципы.</p>
          </div>
          <div class="book-list__item">
            <strong>Всем, кто работает с текстами в IT</strong>
            <p>Редакторам, UX-райтерам и смежным ролям, которым интересна техническая коммуникация.</p>
          </div>
        </div>
      </section>

      <section class="book-section book-section--panel">
        <h2>Что внутри</h2>
        <div class="book-list">
          <div class="book-list__item">
            <strong>Вход в профессию</strong>
            <p>Составление портфолио без опыта, вопросы на собеседованиях, план действий на первый год.</p>
          </div>
          <div class="book-list__item">
            <strong>Аудитория документации</strong>
            <p>Задачи и потребности читателей, метрики полезности, применимые методы исследования.</p>
          </div>
          <div class="book-list__item">
            <strong>Сбор информации</strong>
            <p>Проведение интервью с экспертами, работа с источниками, организация коммуникаций.</p>
          </div>
          <div class="book-list__item">
            <strong>Написание и редактура</strong>
            <p>Правила создания понятного текста, Tone of Voice, стайлгайд, глоссарий, шаблоны.</p>
          </div>
          <div class="book-list__item">
            <strong>Работа в команде</strong>
            <p>Модели взаимодействия, распределение ролей, применение генеративного ИИ, роль профессионального сообщества.</p>
          </div>
        </div>
      </section>
    </div>

    <section id="sold-out" class="book-section book-section--muted book-sold-out">
      <h2>Тираж распродан</h2>
      <p>Первый тираж весь разошёлся. Оставьте почту — напишу лично, как только будет допечатка.</p>
      <form class="book-interest-form" data-product="book" novalidate>
        <label for="interest-email" class="sr-only">Email</label>
        <input
          id="interest-email"
          name="email"
          type="email"
          required
          placeholder="you@example.com"
          class="book-interest-form__input"
        />
        <button type="submit" class="cta-primary">Сообщить почту</button>
        <p class="book-interest-form__msg" role="status"></p>
      </form>
    </section>

  </div>

  <Footer />

  <script>
    const INTEREST_API = 'https://bukvalno.pro/api/interest';

    document.querySelectorAll('.book-interest-form').forEach((form) => {
      const input = form.querySelector('.book-interest-form__input');
      const button = form.querySelector('button[type="submit"]');
      const msg = form.querySelector('.book-interest-form__msg');
      const product = form.dataset.product || '';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!input || !button || !msg) return;

        const email = input.value.trim();
        button.disabled = true;
        button.textContent = 'Шлём…';
        msg.textContent = '';
        msg.className = 'book-interest-form__msg';

        try {
          const res = await fetch(INTEREST_API, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ product, email }),
          });
          const data = await res.json();

          if (data.ok) {
            form.innerHTML = '<p class="book-interest-form__msg book-interest-form__msg--ok">✓ Записали. Напишу лично, как только будет допечатка.</p>';
            return;
          }

          msg.textContent = data.error || 'Что-то пошло не так, попробуйте ещё раз.';
          msg.className = 'book-interest-form__msg book-interest-form__msg--error';
        } catch {
          msg.textContent = 'Не получилось отправить — проверьте связь и попробуйте ещё раз.';
          msg.className = 'book-interest-form__msg book-interest-form__msg--error';
        } finally {
          if (button.isConnected) {
            button.disabled = false;
            button.textContent = 'Сообщить почту';
          }
        }
      });
    });
  </script>

</BaseLayout>

<style>
  .book-hero {
    padding: var(--spacing-xl) var(--spacing-md) var(--spacing-lg);
    max-width: 1100px;
    margin: 0 auto;
  }

  .book-hero__inner {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--spacing-lg);
    align-items: start;
  }

  .book-hero__specs {
    margin-top: var(--spacing-xs);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-align: center;
    opacity: 0.7;
  }

  .book-hero__cover img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.14);
  }

  .book-hero__text h1 {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--spacing-xs);
  }

  .book-hero__desc {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--spacing-sm);
  }

  .book-hero__meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: var(--spacing-md);
  }

  .book-hero__author {
    font-weight: 600;
    font-size: var(--font-size-base);
    color: var(--color-text);
  }

  .book-hero__format {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .book-hero__tagline {
    font-size: var(--font-size-base);
    font-weight: 600;
    color: var(--color-accent-3);
    font-style: italic;
    margin-bottom: var(--spacing-sm);
  }

  .book-cta {
    align-self: flex-start;
  }

  .book-content {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--spacing-md) var(--spacing-xl);
  }

  .book-section {
    padding: var(--spacing-lg) var(--spacing-md);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-md);
  }

  .book-section--muted {
    background: var(--color-bg);
  }

  .book-section--panel {
    background: var(--color-bg-panel);
    border: 1px solid var(--color-border);
  }

  .book-section h2 {
    margin-bottom: var(--spacing-md);
  }

  .book-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }

  .book-two-col .book-section {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .book-two-col {
      grid-template-columns: 1fr;
    }
  }

  /* Unified list style for both columns */
  .book-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .book-list__item {
    padding-bottom: var(--spacing-xs);
    border-bottom: 1px solid var(--color-border);
  }

  .book-list__item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .book-list__item strong {
    display: block;
    margin-bottom: 4px;
    font-size: var(--font-size-base);
    color: var(--color-text);
  }

  .book-list__item p {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* Sold-out section */
  .book-sold-out p {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--spacing-sm);
    max-width: 60ch;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .book-interest-form {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .book-interest-form__input {
    min-width: 0;
    width: 280px;
    max-width: 100%;
    padding: 0.65em 1em;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-panel);
    color: var(--color-text);
    font-size: var(--font-size-base);
  }

  .book-interest-form__input:focus {
    outline: none;
    border-color: var(--color-accent-3);
  }

  .book-interest-form__msg {
    flex-basis: 100%;
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .book-interest-form__msg--ok {
    color: var(--color-accent-3);
    font-weight: 600;
  }

  .book-interest-form__msg--error {
    color: #c0392b;
  }

  @media (max-width: 768px) {
    .book-hero__inner {
      grid-template-columns: 1fr;
    }

    .book-hero__cover {
      max-width: 220px;
      margin: 0 auto;
    }

    .book-hero__text {
      text-align: center;
    }

    .book-hero__meta {
      align-items: center;
    }
  }
</style>
