---
import BaseLayout from '../layouts/BaseLayout.astro';
const projects = [
 {name:'Клеточки',label:'Судоку, японские и поиск слов',description:'Три игры для маленькой паузы. Пометки и объяснения, рисунки по числам и спрятанные слова. 130 судоку, 30 рисунков и 30 тем поиска слов.',url:'/play/',category:'self',tag:'ИГРАТЬ',mark:'▦',color:'sage',fresh:true},
 {name:'Монгол',label:'Монгольский с нуля',description:'Уроки, чтение и аудио, чтобы шаг за шагом знакомиться с языком.',url:'https://mongol.ringova.com',category:'learn',tag:'УЧИТЬСЯ',mark:'М',color:'sand',private:true,alternate:'https://mongol-study-ushkatia.greypike2049.chatgpt.site'},
 {name:'буквально.',label:'Практика технических коммуникаций',description:'Тренажёр и практикум для тех, кто каждый день работает с текстом и знаниями.',url:'https://bukvalno.pro',category:'learn',tag:'УЧИТЬСЯ',mark:'б.',color:'peach'},
 {name:'Огород',label:'Проекты, задачи и контекст',description:'Демонстрация системы, где работа над проектами остаётся в одной памяти.',url:'https://ogorod.ringova.com',category:'work',tag:'РАБОТАТЬ',mark:'⁙',color:'sage'},
 {name:'Контент-фабрика',label:'От мысли к публикации',description:'Темы, черновики и работа над материалами для своих каналов.',url:'https://fabrika.ringova.com',category:'work',tag:'РАБОТАТЬ',mark:'Ф',color:'peach',private:true},
 {name:'Mentor CRM',label:'Менторство без ручного учёта',description:'Клиенты, встречи и баланс часов в одном месте.',url:'https://crm.ringova.com',category:'work',tag:'РАБОТАТЬ',mark:'↗',color:'sand',private:true},
 {name:'Ритм',label:'Повторяющиеся дела в своём темпе',description:'Видеть, что давно не делала, и возвращаться к этому вовремя.',url:'https://ritm.ringova.com',category:'self',tag:'ДЛЯ СЕБЯ',mark:'◷',color:'peach',private:true},
 {name:'Едуш',label:'Еда и покупки',description:'Продукты дома, рецепты и список того, что нужно купить.',url:'https://edush.ringova.com',category:'self',tag:'ДЛЯ СЕБЯ',mark:'е',color:'sage',private:true},
 {name:'Финансы',label:'Личный финансовый учёт',description:'Собрать расходы и доходы в понятную картину.',url:'https://finance.ringova.com',category:'self',tag:'ДЛЯ СЕБЯ',mark:'₽',color:'sand',private:true},
 {name:'Прибыль',label:'Экономика проекта',description:'Доходы, расходы и финансовое планирование.',url:'https://profit.ringova.com',category:'work',tag:'РАБОТАТЬ',mark:'＋',color:'peach',private:true},
 {name:'Личный Огород',label:'Рабочая версия системы',description:'Личный кабинет проектов. Требуется собственный доступ.',url:'https://dashboard.ringova.com',category:'work',tag:'РАБОТАТЬ',mark:'⁙',color:'sage',private:true},
 {name:'Ringova',label:'Консалтинг и знания',description:'Техническая документация, выступления, книга и материалы для специалистов.',url:'https://ringova.com',category:'work',tag:'РАБОТАТЬ',mark:'R',color:'sand'},
];
---
<BaseLayout title="Мои сайты и инструменты — Ringova" description="Проекты Кати: игры, обучение, рабочие и личные инструменты.">
 <main class="projects-page">
  <div class="projects-intro"><p class="kicker">ПРОЕКТЫ КАТИ</p><h1>Для дела.<br/><span>И для себя.</span></h1><p class="intro-copy">Мои сайты и инструменты: учиться, работать<br class="desktop-br"/> и иногда просто закрашивать клеточки.</p></div>
  <div class="project-filters" role="group" aria-label="Отобрать проекты">
   <button class="active" data-filter="all" aria-pressed="true">Все проекты <span>{projects.length}</span></button><button data-filter="learn" aria-pressed="false">Учиться</button><button data-filter="work" aria-pressed="false">Работать</button><button data-filter="self" aria-pressed="false">Для себя</button>
  </div>
  <div class="projects-grid">
   {projects.map(p=><article class:list={['project-card',p.fresh&&'featured']} data-category={p.category}>
    <div class="card-top"><div class:list={['project-mark',p.color]}>{p.mark}</div><span>{p.fresh?'НОВОЕ':p.tag}</span>{p.private&&<span class="private-label">Личный вход</span>}</div>
    <h2><a href={p.url} class="project-title">{p.name}<span aria-hidden="true">↗</span></a></h2><p class="project-label">{p.label}</p><p class="project-description">{p.description}</p>
    <div class="card-bottom"><a class="project-open" href={p.url}>{p.fresh?'Открыть игры':'Открыть сайт'}<span aria-hidden="true"> →</span></a>{p.alternate&&<a class="alternate" href={p.alternate}>Версия в Sites ↗</a>}{p.fresh&&<span class="level-badge">60 уровней</span>}</div>
   </article>)}
  </div>
  <p class="catalogue-note">У личных инструментов сохраняется собственный вход. Данные из них здесь не показываются.</p>
 </main>
 <footer class="projects-footer"><a href="/">Ringova</a><span>Сделано для своих задач. Открыто для любопытства.</span></footer>
</BaseLayout>
<script>
 document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>button.addEventListener('click',()=>{
  const filter=button.dataset.filter;
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button));});
  document.querySelectorAll<HTMLElement>('[data-category]').forEach(card=>{card.hidden=filter!=='all'&&card.dataset.category!==filter;});
 }));
</script>
<style>
 .projects-page{max-width:1180px;margin:auto;padding:90px 40px 64px}.projects-intro{padding-bottom:40px}.kicker{font-size:11px;letter-spacing:2.2px;color:#b25e4e;font-weight:600;margin:0 0 24px}h1{font-size:clamp(46px,6.8vw,82px);line-height:1.07;letter-spacing:-3px;font-weight:600;margin:0 0 27px;color:#262d29}h1 span{color:#a85a4a}.intro-copy{font-size:16px;line-height:1.8;color:#7a8078;margin:0}.project-filters{display:flex;align-items:center;gap:10px;padding:19px 0 25px;border-top:1px solid #e9e8e1}.project-filters button{border:0;background:none;font:inherit;font-size:12px;color:#7e8279;padding:11px 16px;border-radius:7px;cursor:pointer;min-height:44px}.project-filters button.active{background:#f0eee5;color:#2f3a30}.project-filters button span{font-size:9px;margin-left:7px;color:#969a8d}.projects-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.project-card{border:1px solid #e2e4da;border-radius:12px;padding:26px;background:#fff;display:flex;flex-direction:column;min-height:306px}.project-card.featured{background:#f0f2e8;border-color:#cdd5bf}.project-card[hidden]{display:none}.card-top{display:flex;align-items:center;gap:12px;margin-bottom:25px;color:#979c90;font-size:8px;letter-spacing:1.3px}.project-mark{width:42px;height:42px;display:flex;align-items:center;justify-content:center;border-radius:10px;font-size:24px;font-weight:500;letter-spacing:-1px}.sage{background:#dfe7d4;color:#526344}.sand{background:#f0e7d6;color:#9b8153}.peach{background:#f6e3db;color:#b3634f}.card-top .private-label{margin-left:auto;letter-spacing:0;font-size:8px;color:#9ca293}.project-card h2{font-size:26px;line-height:1.2;letter-spacing:-.7px;font-weight:500;margin:0 0 9px}.project-title{display:flex!important;justify-content:space-between;align-items:center;gap:8px;text-decoration:none!important;background-image:none!important;color:#2d382d!important}.project-title span{color:#a1a995;font-size:20px;font-weight:400}.project-label{font-size:11px;color:#6e7b63;margin:0 0 12px}.project-description{font-size:12px;line-height:1.9;color:#8a9182;margin:0 0 24px;flex:1}.card-bottom{display:flex;gap:10px;align-items:center;justify-content:space-between;min-height:26px}.project-open{font-size:11px!important;color:#667758!important;text-decoration:none!important;background-image:none!important;min-height:32px;display:flex!important;align-items:center}.project-open span{padding-left:7px}.alternate{font-size:8px!important;color:#9aa18e!important;text-decoration:none!important;background-image:none!important}.level-badge{font-size:9px;padding:6px 9px;background:#e1e8d6;color:#6e805a;border-radius:4px}.catalogue-note{margin:28px 0 0;font-size:10px;line-height:1.8;color:#9aa18f}.projects-footer{max-width:1100px;margin:auto;border-top:1px solid #e7e8e0;padding:26px 0 35px;display:flex;align-items:center;justify-content:space-between;font-size:10px;color:#a1a695}.projects-footer a{font-size:17px;color:#79856d;text-decoration:none!important;background-image:none!important}.projects-page :global(a::after),.projects-footer :global(a::after){content:none!important}.project-filters button:focus-visible,.project-card a:focus-visible{outline:2px solid #b3634f;outline-offset:4px}
 @media(max-width:960px){.projects-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.projects-page{padding:65px 30px 45px}.projects-footer{margin:0 30px}.card-top .private-label{font-size:7px}.project-card{padding:23px}}
 @media(max-width:600px){.projects-page{padding:45px 20px 35px}.projects-intro{padding-bottom:29px}.kicker{font-size:9px;margin-bottom:19px}h1{font-size:53px;letter-spacing:-2px;margin-bottom:22px}.intro-copy{font-size:13px}.desktop-br{display:none}.project-filters{gap:1px;padding:14px 0 20px;justify-content:space-between}.project-filters button{font-size:10px;padding:9px 10px}.project-filters button span{font-size:8px;margin-left:3px}.projects-grid{grid-template-columns:1fr;gap:13px}.project-card{min-height:276px;padding:24px}.card-top{margin-bottom:21px}.project-card h2{font-size:27px}.project-description{font-size:12px;max-width:320px}.project-label{font-size:11px}.card-top .private-label{font-size:8px}.projects-footer{margin:0 20px;padding:25px 0;gap:20px;align-items:flex-start}.projects-footer span{font-size:8px;line-height:1.8;max-width:190px}.catalogue-note{font-size:9px}}
</style>
